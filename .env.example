# SQLite database location (relative to prisma/)
DATABASE_URL="file:./dev.db"

# 32-byte hex key for credential encryption + cookie signing.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# "mock" (fixtures, default) or "live" (real Ocado + Apify)
PROVIDERS_MODE="mock"

# Optional: password-protect the app (recommended if exposed beyond localhost)
APP_PASSWORD=""

# Apify — required for PROVIDERS_MODE=live
APIFY_TOKEN=""
# Defaults to junglee/amazon-crawler if unset
APIFY_ACTOR_ID=""
